# Copiar a .env y completar
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=America/Guayaquil

# PostgreSQL
DB_NAME=campeonato
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS (en producción, lista separada por comas del/los dominios del front)
CORS_ORIGINS=http://localhost:4200

# Firebase Cloud Messaging: ruta al JSON de la cuenta de servicio (opcional en desarrollo)
FCM_CREDENTIALS_FILE=
