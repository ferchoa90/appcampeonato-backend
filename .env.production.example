# Copiar a /opt/goalscore/backend/.env en el servidor (chmod 600) y completar los valores.
DEBUG=False
# Generar: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# IMPORTANTE: no cambiarla después; cifra las claves guardadas en Configuración (SMTP, VAPID).
SECRET_KEY=

ALLOWED_HOSTS=api.goalscore.acepsistemas.com
CSRF_TRUSTED_ORIGINS=https://api.goalscore.acepsistemas.com
CORS_ORIGINS=https://goalscore.acepsistemas.com
USAR_HTTPS=True
NUM_PROXIES=1

DB_ENGINE=postgres
DB_NAME=goalscore
DB_USER=goalscore
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

STATIC_ROOT=/var/www/goalscore/static
MEDIA_ROOT=/var/www/goalscore/media
CACHE_DIR=/var/cache/goalscore

# Notificaciones push a la app móvil (JSON de cuenta de servicio de Firebase). Opcional.
FCM_CREDENTIALS_FILE=/opt/goalscore/secrets/firebase.json
